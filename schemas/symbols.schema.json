{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rerevved.local/schemas/symbols.schema.json",
  "title": "ReRevved symbol catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalog", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "catalog": { "const": "symbols" },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "address",
        "image",
        "claim",
        "confidence",
        "evidence",
        "qualification"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^RVA-SYM-[0-9]{4}$" },
        "name": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "kind": { "enum": ["function", "global"] },
        "address": { "$ref": "common.schema.json#/$defs/address" },
        "image": { "$ref": "common.schema.json#/$defs/image" },
        "claim": { "type": "string", "minLength": 1 },
        "confidence": { "$ref": "common.schema.json#/$defs/confidence" },
        "evidence": { "$ref": "common.schema.json#/$defs/evidence" },
        "qualification": { "$ref": "common.schema.json#/$defs/qualification" }
      }
    }
  }
}
